PULSAR_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
PULSAR_ADMIN_USERNAME=yourname
PULSAR_ADMIN_PASSWORD=a-strong-password
PULSAR_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins for the browser frontend.
# Defaults to the dev ports below; add your own origin if you serve from elsewhere.
PULSAR_CORS_ORIGINS=http://localhost:8000,http://localhost:8001

# Free Demo API key from https://www.coingecko.com/en/api/pricing
# Required for OHLC history, signals, backtesting, and ML scoring.
COINGECKO_API_KEY=your-demo-api-key-here

# Only needed if you have a paid CoinGecko Pro plan
# COINGECKO_PRO_API_KEY=your-pro-api-key-here
